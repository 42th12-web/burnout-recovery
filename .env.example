# 실제 값은 .env 파일에만 넣으세요. .env는 .gitignore에 등록돼 GitHub에 올라가지 않습니다.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# SECRET_KEY는 서버(Edge Function)에서만 사용합니다. 절대 프론트엔드 코드에 넣지 마세요.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://xxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json
